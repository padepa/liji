        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Liji does not provide accounts or cross-device cloud sync. Deleting the app removes its current local workout records. If iCloud or computer device backups are enabled, iOS may include app data in a system backup managed by Apple and your system settings."
