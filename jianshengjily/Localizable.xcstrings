        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your heels planted, brace your glutes and core, and hold your body like a plank."
          }
        }
      }
    },
    "脚掌持续发力，胸肩同步把杠铃推回起点。": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
